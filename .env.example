# Example local-dev secrets for moony.
#
# Copy to `.env` (gitignored) and fill in real values, OR point MN_ENV_FILE at a
# file outside the repo: `export MN_ENV_FILE=~/.config/moony/.env`.
# Real environment variables always win over .env.
#
# Loaded for unset vars only; the bash/job tools strip the secrets below from
# agent-run commands so the model can't read them.

# Which backend provider to use: ollama (default), openai, anthropic, openrouter.
# Also settable at runtime with /provider; this overrides the saved choice.
# MN_PROVIDER=ollama

# Default model id for the active provider (also settable with /model).
# MN_MODEL=llama3.1:8b

# --- Ollama (local, default; no key) -------------------------------------
# MN_OLLAMA_HOST=http://localhost:11434
# MN_OLLAMA_TOKEN=            # optional bearer for a remote/protected server

# --- OpenAI --------------------------------------------------------------
# MN_OPENAI_API_KEY=          # or the conventional OPENAI_API_KEY
# MN_OPENAI_BASE_URL=https://api.openai.com/v1

# --- Anthropic (Claude) --------------------------------------------------
# MN_ANTHROPIC_API_KEY=       # or the conventional ANTHROPIC_API_KEY
# MN_ANTHROPIC_BASE_URL=https://api.anthropic.com
# Force-strip replayed thinking blocks (for gateways that can't re-validate
# their signatures). Auto-detected on a 400; set this to skip the one-time probe.
# MN_ANTHROPIC_STRIP_THINKING=0

# --- SQE Anthropic (Claude via the SQE LAN gateway) ----------------------
# Same wire + models as Anthropic; only the default base URL differs. The key
# falls back to MN_ANTHROPIC_API_KEY when unset. Select with /provider sqe-anthropic.
# MN_SQE_ANTHROPIC_API_KEY=
# MN_SQE_ANTHROPIC_BASE_URL=http://192.168.33.158:8787

# --- OpenRouter (one key, many models) -----------------------------------
# MN_OPENROUTER_API_KEY=      # or the conventional OPENROUTER_API_KEY
# MN_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- OmniRoute (local OpenAI-compatible gateway) -------------------------
# A self-hosted router (github.com/diegosouzapw/OmniRoute) on localhost:20128.
# Key from its Dashboard → Endpoints. Select with /provider omniroute; use its
# prefix/model ids (e.g. kr/claude-sonnet-4.5) or the zero-config "auto".
# MN_OMNIROUTE_API_KEY=
# MN_OMNIROUTE_BASE_URL=http://localhost:20128/v1

# --- Relay auth (optional; OFF by default) -------------------------------
# The relay serves no auth unless MN_AUTH=on. When on, browsers log in via
# your OIDC provider (per-user isolation: each user sees only their own
# machines), and connectors (TUI/daemon) authenticate with a per-user token
# obtained from the relay's /connect page. All values below are read by the
# `moony relay` binary; the relay fails to start if MN_AUTH=on and any
# required OIDC var is missing (fail closed).
# MN_AUTH=on
# MN_AUTH_SECRET=              # >=16 bytes; signs session cookies + connector tokens
# MN_OIDC_ISSUER=https://accounts.google.com          # your IdP's issuer URL
# MN_OIDC_CLIENT_ID=
# MN_OIDC_CLIENT_SECRET=
# MN_OIDC_REDIRECT_URL=https://relay.example.com/auth/callback
# MN_OIDC_ACCOUNT_CLAIM=email # ID-token claim used as the account (default: email)
# MN_AUTH_TTL=12h             # browser session lifetime (default 12h)
# MN_AUTH_ADMINS=you@example.com   # comma-separated accounts allowed to author announcements

# --- Connector (TUI / daemon) side of relay auth -------------------------
# MN_RELAY=relay.example.com:8771       # relay tunnel address to dial (also `moony --relay`)
# MN_RELAY_TOKEN=             # per-user connector token from the relay's /connect page

