# Example local-dev secrets for moony.
#
# Copy to `.env` (gitignored) and fill in real values, OR point SQE_ENV_FILE at a
# file outside the repo: `export SQE_ENV_FILE=~/.config/moony/.env`.
# Real environment variables always win over .env.
#
# Loaded for unset vars only; the bash/job tools strip the secrets below from
# agent-run commands so the model can't read them.

# Which backend provider to use: ollama (default), openai, anthropic, openrouter.
# Also settable at runtime with /provider; this overrides the saved choice.
# SQE_PROVIDER=ollama

# Default model id for the active provider (also settable with /model).
# SQE_MODEL=llama3.1:8b

# --- Ollama (local, default; no key) -------------------------------------
# SQE_OLLAMA_HOST=http://localhost:11434
# SQE_OLLAMA_TOKEN=            # optional bearer for a remote/protected server

# --- OpenAI --------------------------------------------------------------
# SQE_OPENAI_API_KEY=          # or the conventional OPENAI_API_KEY
# SQE_OPENAI_BASE_URL=https://api.openai.com/v1

# --- Anthropic (Claude) --------------------------------------------------
# SQE_ANTHROPIC_API_KEY=       # or the conventional ANTHROPIC_API_KEY
# SQE_ANTHROPIC_BASE_URL=https://api.anthropic.com

# --- OpenRouter (one key, many models) -----------------------------------
# SQE_OPENROUTER_API_KEY=      # or the conventional OPENROUTER_API_KEY
# SQE_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
