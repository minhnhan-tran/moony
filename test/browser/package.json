{
  "name": "sqe-browser-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Playwright bot that simulates a real human driving the moony web UI, with an LLM persona brain (../../bin/sim-decide).",
  "scripts": {
    "test": "playwright test",
    "test:persona": "playwright test persona",
    "test:journey": "playwright test journey",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report",
    "login": "playwright open --save-storage=.auth/state.json"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
